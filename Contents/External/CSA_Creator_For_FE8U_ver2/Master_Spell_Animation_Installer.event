//Master Animation Installer
#define setCSATable(index, framedata, RTLFG, LTRFG, RTLBG, LTRBG) "PUSH; ORG CSATable+(index*20); POIN framedata RTLFG LTRFG RTLBG LTRBG; POP"
#define setCustomSpell_dim(index) "PUSH; ORG SpellTable+(index*4); POIN CSAEngine_Dim|1; POP"
#define setCustomSpell_nodim(index) "PUSH; ORG SpellTable+(index*4); POIN CSAEngine_NoDim|1; POP"

SpellTable:	 // Was $5d4e60
#incbin "RepointedSpellTable.dmp"

CSATable:
#incbin "BlankCSATable.dmp"

// JESTER - Originally $95d780 but it causes the background 0x35 to glitch. It was then at a fixed ORG 0x1000000,
// which the free space reached: EfxSkillVanilla was assembled there too and the engine overwrote it, so every skill
// with the vanilla skill animation (Astra, Adept, ...) froze the battle. It goes in the free space like the rest.
// CSA_System_fe8.event is CSA_System_fe8.dmp with its pointers into itself made relative to CSAEngine: the dump was
// built for 0x95D780, so moved anywhere else its proc script and entry points pointed at empty ROM there.
ALIGN 4
CSAEngine:
#include "CSA_System_fe8.event" //the custom spell engine. All custom spells point here.
POIN CSATable //needed for the routine

#define CSAEngine_Dim (CSAEngine + 0x6C) // Originally $95d7ec (it was + 0x5C, inside a literal pool)
#define CSAEngine_NoDim (CSAEngine + 0x118) // Originally $95d898 // the last word in the dmp, this should be updated if you edit the engine.

#include "CustomSpells/Atlas/Spell.event"
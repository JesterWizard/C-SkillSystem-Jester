// Every Gorgon Egg (CLASS_GORGONEGG and CLASS_GORGONEGG2, Data/ClassData/ClassData.c), unarmed: "[Gorgon-Custom] [U] Gorgon Eggs" by Ryn
#define BANIM_GORGON_EGG_UNARMED 0xDE
#include "Classes/GorgonEgg/GorgonEggUnarmed.event"
PUSH
BanimEntry(BANIM_GORGON_EGG_UNARMED)
GorgonEggUnarmed_BANIM_ENTRY
POP
ALIGN 4
gBanimDef_GorgonEgg:
// any weapon an egg holds (it never attacks) keeps the egg animation, so the fight isn't dropped to the map
BYTE 0x09 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x00 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x01 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x02 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x03 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x04 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x05 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x06 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x07 0x01; SHORT BANIM_GORGON_EGG_UNARMED
BYTE 0x0B 0x01; SHORT BANIM_GORGON_EGG_UNARMED
WORD 0

// Third-tier classes' animations (Documentation/Features/ThirdTierClasses.md), installed with CONFIG_THIRD_TIER_CLASSES.
// The Trickster, Marshall, Trueblade and Archsage classes use them class-wide (gBanimDef_T3*, below, their
// pBattleAnimDef in Data/ClassData/ClassData.c); the Dinar87 Archsage (0xE0) is installed but unused.
#ifdef CONFIG_THIRD_TIER_CLASSES

// Trueblade (Swordmaster's third tier; Joshua), sword: "[Swordmaster-Variant] Trueblade [M]- Joshua"
#define BANIM_T3_TRUEBLADE_SWORD 0xDF
#include "ThirdTier/Trueblade/TruebladeSword.event"

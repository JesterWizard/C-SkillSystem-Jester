BanimEntry(BANIM_AMELIA_LANCE)
AmeliaLance_BANIM_ENTRY
POP

// Amelia's Recruit animations: lances use her animation, unarmed keeps vanilla Recruit's (0x97)
ALIGN 4
gBanimDef_AmeliaRecruit:
BYTE 0x01 0x01; SHORT BANIM_AMELIA_LANCE
BYTE 0x09 0x01; SHORT 0x97
WORD 0


#define FE8U_BattleGetFollowUpOrder $2AF90

PUSH
ORG FE8U_BattleGetFollowUpOrder
    jumpToHack(BattleGetFollowUpOrder_WaryFighter)
    PROTECT FE8U_BattleGetFollowUpOrder FE8U_BattleGetFollowUpOrder + 0x8 // BattleGetFollowUpOrder hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_wary_fighter:
#include "Source/BattleGetFollowUpOrder_WaryFighter.lyn.event"
#include "WaryFighterUnits.event"
PROTECT StandaloneBody_wary_fighter CURRENTOFFSET // body + config

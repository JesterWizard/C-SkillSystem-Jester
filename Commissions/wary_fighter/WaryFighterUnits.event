/* 0 = use the unit and class lists below
 * 1 = everyone, always-on
 * 2 = everyone, enemy-initiated only
 *
 * Specific unit IDs beat specific class IDs. Both beat $FF fallbacks.
 */
#define WARY_LIST       0
#define WARY_ALWAYS     1
#define WARY_ENEMY_INIT 2

#define WaryFighterUnit(pid, version) "BYTE pid version"
#define WaryFighterClass(jid, version) "BYTE jid version"

ALIGN 4
WaryFighterGlobalMode:
BYTE WARY_LIST

ALIGN 4
WaryFighterUnits:
// WaryFighterUnit($01, WARY_ALWAYS)     // Eirika
// WaryFighterUnit($02, WARY_ENEMY_INIT) // Seth

// WaryFighterUnit($FF, WARY_ALWAYS)     // everyone else, all combats (global)
// WaryFighterUnit($FF, WARY_ENEMY_INIT) // everyone else, enemy-initiated only (global)
WaryFighterUnit($00, $00) // end of table

ALIGN 4
WaryFighterClasses:

/*
 * Accessory items: the item IDs (as in FEBuilder's item editor) that only go in the accessory slot.
 *
 * A unit carries at most one accessory and at most four other items. Its accessory is always its last item, after
 * the others: with four other items it is in the fifth slot.
 *
 * Add one AccessoryItem line per item, before the end of the list. Up to 255 items.
 *
 * Weapon locks: tick a weapon lock on an accessory in FEBuilder's item editor (as for a weapon) and only units whose
 * character or class has that lock can carry it.
 */
#define AccessoryItem(id) "BYTE id"

ALIGN 4
AccessorySlotItems:
// AccessoryItem($AB) // e.g. a custom ring made with FEBuilder
// AccessoryItem($AC)
BYTE $00 // end of the list
ALIGN 4

/*
 * Stat bonuses: an accessory the unit can wear (its weapon locks allow it) adds its stat bonuses to the unit's stats
 * while it is carried. By default they are the item's stat bonuses in FEBuilder's item editor. An AccessoryStats line
 * here replaces them for that item: HP, Str (or Mag), Skl, Spd, Def, Res, Lck, Mov, Con. Negative values work.
 */
#define AccessoryStats(id, hp, str, skl, spd, def, res, lck, mov, con) "BYTE id hp str skl spd def res lck mov con"

ALIGN 4
AccessorySlotStats:
// AccessoryStats($AB, 0, 2, 0, 0, 0, 0, 0, 0, 0) // e.g. a Power Ring: +2 Str
// AccessoryStats($AC, 0, 0, 0, 0, 0, 0, 0, 2, 0) // e.g. Boots: +2 Mov
BYTE $00 // end of the list
ALIGN 4

/*
 * The blue "equipped" bar on the stat screen's item page:
 *   0 = none
 *   1 = always under slot 5, the accessory slot
 *   2 = under the unit's accessory, wherever it is (slot 5 with four other items), none without one
 */
AccessorySlotBar:
BYTE 1
ALIGN 4

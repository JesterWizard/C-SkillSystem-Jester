#ifndef TUTORIALS_INSTALLED
#define TUTORIALS_INSTALLED

/**
 * Tutorials (Documentation/Features/Tutorials.md): Extras > Tutorials, the last Extras row, and its screen. WIZARDRY_CUSTOM.
 * The row's label is in the Extras label sheet (NewGamePlus/Gfx/Img_NgpMenuObjs.png), its sprite in gExtrasLabelSprites
 * (NewGamePlus/Source/NgpSaveMenu.c). The tutorials are listed in Source/TutorialsData.c, their text at the end of
 * Contents/Texts/Source/texts/Districts.txt.
 */
#include "Source/LynJump.event"
#include "Source/TutorialsExtras.lyn.event"
#include "Source/TutorialsScreen.lyn.event"
#include "Source/TutorialsData.lyn.event"
#include "Source/TutorialTitles.lyn.event"
#include "Source/TutorialMap.lyn.event"
#include "Source/TutorialGuides.lyn.event"

/*
 * The tutorials' maps (Source/TutorialMap.c): the game control's label 9 (GameControl_PostChapterSwitch) and the save
 * menu's first SaveMenu_LoadExtraMenuGraphics, as proc script pointers
 */
PUSH
ORG $591900
POIN TutorialMap_PostChapterSwitch
ORG $A200EC
POIN TutorialMap_LoadExtraMenuGraphics
POP

#endif /* TUTORIALS_INSTALLED */

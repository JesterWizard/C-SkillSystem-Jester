#ifndef CHAPTER_RESULTS_INSTALLED
#define CHAPTER_RESULTS_INSTALLED

/**
 * Chapter results (WIZARDRY_CUSTOM, so FreeSpaceDEMO): the screen after a cleared story chapter, before the awards and

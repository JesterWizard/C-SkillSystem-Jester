 * GameControl_CallPostChapterSaveMenu (Guild/Source/ChapterAwards.c) starts it; the first player phase's snapshot is
 * ChapterResults_PrePhase (PrePhaseHook/data.event).
 */
#include "Source/ChapterResults.lyn.event"

#endif /* CHAPTER_RESULTS_INSTALLED */

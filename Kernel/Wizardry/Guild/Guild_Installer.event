/* The board's screen (ProcScr_GuildScreen): quests, prizes and records. */
#include "Source/GuildScreen.lyn.event"

/* The board's A-press handler, its event, the map fade wrapper and the map markers. */
#include "Source/GuildDistrict.lyn.event"

#endif /* DISTRICT_GUILD_INSTALLED */

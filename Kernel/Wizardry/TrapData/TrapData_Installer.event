#include "LynJump.event"
#include "TrapData.lyn.event"

/*
 * Trap map sprite images. The standing map sprite table entries that use
 * them are in Data/UnitIcon/UnitIconWait.c (ids in include/kernel/unit-icon.h).
 */

/* Heal Tile */
Gfx_Heal_Tile:
#incext Png2Dmp "images/Heal_Tile.png" --lz77

/* Dragon Vein Tile */
Gfx_Dragon_Vein_Tile:
#incext Png2Dmp "images/Dragon_Vein_Tile.png" --lz77

/* Hellscape Void Tile */
Gfx_Hellscape_Void_Tile:
#incext Png2Dmp "images/Hellscape_Void_Tile.png" --lz77

/* Caltrops Tile (hidden caltrops, once revealed) */
Gfx_Caltrops_Tile:
#incext Png2Dmp "images/Caltrops_Tile.png" --lz77

/* Collapsing floor tiles: intact, cracked, hole (IDs follow COLLAPSING_FLOOR_* order) */
Gfx_Floor_Intact_Tile:
#incext Png2Dmp "images/Floor_Intact_Tile.png" --lz77
Gfx_Floor_Cracked_Tile:
#incext Png2Dmp "images/Floor_Cracked_Tile.png" --lz77
Gfx_Floor_Hole_Tile:
#incext Png2Dmp "images/Floor_Hole_Tile.png" --lz77

/* Lit Torch Tile*/
Gfx_Lit_Torch:
#incext Png2Dmp "images/Lit_Torch_Tile.png" --lz77

/* Unlit Torch Tile */
Gfx_Unlit_Torch:
#incext Png2Dmp "images/Unlit_Torch_Tile.png" --lz77

/* Teleport Tile */
Gfx_Teleport_Tile: #incext Png2Dmp "images/Teleport_Tile.png" --lz77

/* Grass Tile */
Gfx_Grass_Tile: #incext Png2Dmp "images/Grass_Tile.png" --lz77
Pal_Grass_Tile: #incext Png2Dmp "images/Grass_Tile.png" --palette-only

/* Boulder Tile */
Gfx_Boulder_Tile: #incext Png2Dmp "images/Boulder_Tile.png" --lz77

/* Spin Tile */
Gfx_Spin_Tile_LEFT: #incext Png2Dmp "images/Spin_Tile_LEFT.png" --lz77
Gfx_Spin_Tile_RIGHT: #incext Png2Dmp "images/Spin_Tile_RIGHT.png" --lz77
Gfx_Spin_Tile_UP: #incext Png2Dmp "images/Spin_Tile_UP.png" --lz77
Gfx_Spin_Tile_DOWN: #incext Png2Dmp "images/Spin_Tile_DOWN.png" --lz77

Pal_Spin_Tile: #incext Png2Dmp "images/Spin_Tile_RIGHT.png" --palette-only


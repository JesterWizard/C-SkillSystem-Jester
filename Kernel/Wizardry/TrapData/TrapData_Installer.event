#include "LynJump.event"
#include "TrapData.lyn.event"

/* Heal Tile */
#define Gfx_Heal_Tile_ID 0x68

Gfx_Heal_Tile:
#incext Png2Dmp "images/Heal_Tile.png" --lz77

PUSH
	ORG (0x8AF880+0x8*Gfx_Heal_Tile_ID)
		SHORT 0x0002
		SHORT 0x0000
		POIN Gfx_Heal_Tile
POP


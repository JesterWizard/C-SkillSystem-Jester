ALIGN 4
Pal_SSRed:
#incbin "img/SSRedPal.dmp"

ALIGN 4
Pal_SSGreen:
#incbin "img/SSGreenPal.dmp"

ALIGN 4
Pal_SSGold:
#incbin "img/SSGoldPal.dmp"

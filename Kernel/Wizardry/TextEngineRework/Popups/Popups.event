// Text engine popups: "Objection!"-style cut-ins shown with [Popup][XX].
// XX is the 1-based entry below. Art comes from generate_popups.py; convert
// each PNG with the makefile's grit rule (*.img.bin / *.map.bin / *.pal.bin).
// Each popup must fit in the dialogue text tiles (240 tiles) and 30x20 tiles.

ALIGN 4
TextEnginePopupTable:
// tiles, tilemap, palette, width, height (tiles), sound effect (0 = none)
POIN Popup_Objection_Img Popup_Objection_Map Popup_Objection_Pal; BYTE 30 16; SHORT 0xD8 // 0x01 [Objection]
POIN Popup_HoldIt_Img Popup_HoldIt_Map Popup_HoldIt_Pal; BYTE 30 16; SHORT 0xD8          // 0x02 [HoldIt]
POIN Popup_TakeThat_Img Popup_TakeThat_Map Popup_TakeThat_Pal; BYTE 30 16; SHORT 0xD8    // 0x03 [TakeThat]
WORD 0 0 0 0

ALIGN 4
Popup_Objection_Img:
#incbin "Objection.img.bin"
ALIGN 4
Popup_Objection_Map:
#incbin "Objection.map.bin"
ALIGN 4
Popup_Objection_Pal:
#incbin "Objection.pal.bin"

ALIGN 4
Popup_HoldIt_Img:
#incbin "HoldIt.img.bin"
ALIGN 4
Popup_HoldIt_Map:
#incbin "HoldIt.map.bin"
ALIGN 4
Popup_HoldIt_Pal:
#incbin "HoldIt.pal.bin"

ALIGN 4
Popup_TakeThat_Img:
#incbin "TakeThat.img.bin"
ALIGN 4
Popup_TakeThat_Map:
#incbin "TakeThat.map.bin"
ALIGN 4
Popup_TakeThat_Pal:
#incbin "TakeThat.pal.bin"

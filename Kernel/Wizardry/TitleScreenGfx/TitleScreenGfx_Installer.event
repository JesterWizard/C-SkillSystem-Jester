// Title screen graphics installer.
// Points the vanilla FE8U title screen at the new graphics in TitleScreenGfx_Data.event.
// Generated by hand; see Documentation/Features/TitleScreenGfx.md and Tools/titlescreen/title_gfx.py.

#include "TitleScreenGfx_Data.event"

PUSH

// Title_SetupMainGraphics (0x080C56F4): BG1 background (palette bank 14)
ORG $C5730 ; POIN TitleBg_TilesA
ORG $C5780 ; POIN TitleBg_TilesB
ORG $C5788 ; POIN TitleBg_Map
ORG $C5790 ; POIN TitleBg_Pal
// the background palette is also loaded by the intro effects
ORG $C5CC0 ; POIN TitleBg_Pal
ORG $C5F1C ; POIN TitleBg_Pal
ORG $C62B4 ; POIN TitleBg_Pal
// BG0 emblem (palette bank 15)
ORG $C57E4 ; POIN TitleEmblem_Tiles
ORG $C57EC ; POIN TitleEmblem_Map
ORG $C57F4 ; POIN TitleEmblem_Pal
ORG $C62C0 ; POIN TitleEmblem_Pal
// OBJ tiles 0x000-0x15F and OBJ palettes 0-3 (0x06013000 tiles: copyright and Press START, kept vanilla)
ORG $C5808 ; POIN TitleObj_Tiles
ORG $C5838 ; POIN TitleObj_Pal

// DrawTitleSprites_Loop (0x080C5440)
// call 1: "Fire Emblem" logo, attr2 base 0x2000 (palette 2, tile 0)
ORG $C5450 ; BYTE TITLE_LOGO_X
ORG $C5452 ; BYTE TITLE_LOGO_Y
ORG $C54F4 ; POIN TitleLogo_Layout
// call 2 (was the TM): EXCEED, attr2 base TITLE_EXCEED_ATTR2 (palette and base tile)
ORG $C5462 ; BYTE TITLE_EXCEED_X
ORG $C5464 ; BYTE TITLE_EXCEED_Y
ORG $C54F8 ; POIN TitleExceed_Layout
ORG $C54FC ; WORD TITLE_EXCEED_ATTR2
// call 3 (the vanilla logo's translucent shine): moved off screen (y 160)
ORG $C5500 ; WORD 0xA0
// call 4: banner, attr2 base TITLE_BANNER_ATTR2 (palette and base tile)
ORG $C5484 ; BYTE TITLE_BANNER_X
ORG $C5486 ; BYTE TITLE_BANNER_Y
ORG $C5504 ; POIN TitleBanner_Layout
ORG $C5508 ; WORD TITLE_BANNER_ATTR2
// call 5: Press START, 5 px lower (was y 124)
ORG $C5498 ; BYTE 129

// Title_Loop_LightExplosionFx (0x080C6204): draws the banner during the intro
ORG $C6290 ; BYTE TITLE_BANNER_X
ORG $C6292 ; BYTE TITLE_BANNER_Y
ORG $C62C4 ; POIN TitleBanner_Layout
ORG $C62C8 ; WORD TITLE_BANNER_ATTR2

// Title_PrepareMainLogoZoom (0x080C5FE8): the intro zoom (BG2, 8bpp affine)
ORG $C6070 ; POIN TitleZoom_Tiles
ORG $C6078 ; POIN TitleZoom_Map
ORG $C6080 ; POIN TitleZoom_Pal

POP

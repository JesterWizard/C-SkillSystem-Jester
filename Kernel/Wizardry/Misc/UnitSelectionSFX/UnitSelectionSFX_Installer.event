ALIGN 4
Artur_3_map:
    WORD $3C00
    POIN Artur_3_wav
    WORD $FF00FF

ALIGN 4
Artur_3_Sound:
    WORD 1
    POIN Artur_3_map
    POIN VoiceSound_data

SongTable(0x3A1, Artur_3_Sound, 7)


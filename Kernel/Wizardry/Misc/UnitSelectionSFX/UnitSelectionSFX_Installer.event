#include "EAstdlib.event"
#include "Extensions/Hack Installation.txt"
#ifndef SongTableOffset
#define SongTableOffset  0x224470
#define SongTable(index,SongPointer,Group) "PUSH; ORG SongTableOffset+(8*index); POIN SongPointer; SHORT Group Group; POP"
#endif

// ======================================================
// Shared Sound Data (ONE TIME)
// ======================================================
ALIGN 4
VoiceSound_data:
    BYTE $BE $7F $BC $00 $BB $05 $BD $00 $E7 $3C $40 $98 $B1 $79 $83 $83

// ======================================================
// JOSHUA
// ======================================================
ALIGN 4
Joshua_1_wav:
    #incbin "dmp/Joshua/Joshua_Hurry_Up_Will_You_Compressed.dmp"

ALIGN 4
Joshua_1_map:
    WORD $3C00
    POIN Joshua_1_wav
    WORD $FF00FF

ALIGN 4
Joshua_1_Sound:
    WORD 1
    POIN Joshua_1_map
    POIN VoiceSound_data

SongTable(0x26D, Joshua_1_Sound, 7)

ALIGN 4
Joshua_2_wav:
    #incbin "dmp/Joshua/Joshua_Im_Already_There_Compressed.dmp"


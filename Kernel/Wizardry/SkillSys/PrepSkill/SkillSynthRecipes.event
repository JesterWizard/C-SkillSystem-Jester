// Skill Synthesis recipes. Each row is an unordered pair of ingredient SIDs
// and the resulting SID. Lookup in SkillSynth.c treats A+B the same as B+A.
//
// Edit this file to add or change recipes. End the table with SkillSynthRecipe(0, 0, 0).
// SID_* values come from include/constants/skills.event (EA copy of skills.h).

#include "../../../../include/constants/skills.event"

#ifndef SkillSynthRecipe
#define SkillSynthRecipe(a, b, result) "SHORT a b result"
#endif

ALIGN 4
gSkillSynthRecipeTable:
    // Two copies of a skill produce its Plus variant.

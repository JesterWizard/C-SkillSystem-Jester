#ifndef GROWTH_RADAR_INSTALLED
#define GROWTH_RADAR_INSTALLED

/**
 * Growth Radar: the stat screen's "Growths" page, a radar chart of the unit's growths and of its stats against
 * their caps (Documentation/Features/GrowthRadar.md). Its draw function is page 8 of gStatScreenDrawPages
 * (Kernel/Wizardry/StatScreen/data.event). WIZARDRY_CUSTOM, so FreeSpaceDEMO.
 */
#include "Source/GrowthRadar.lyn.event"
#include "Source/GrowthRadarHelp.lyn.event"

/* The chart's grid: 12x12 4bpp tiles in chart order, drawn by Gfx/make-grid.py */
ALIGN 4
Img_GrowthRadarGrid:
    #incbin "Gfx/Img_GrowthRadarGrid.4bpp"

#endif /* GROWTH_RADAR_INSTALLED */

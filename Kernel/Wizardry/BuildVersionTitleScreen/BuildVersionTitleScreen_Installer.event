#include "EAstdlib.event"
#include "Extensions/Hack Installation.txt"
PUSH
//ORG $CA278	//{J}
ORG $C54B0	//{U}
jumpToHack(display_version)


//���̒l�́AFEBuilderGBA��UPS���쐬����ƁA�����I�ɍX�V����܂��B
//FEBuilderGBA��UPS�����Ȃ��ꍇ�́A�����ł��̒l�������ւ��Ă��������B
//This value is automatically updated when you create a UPS with FEBuilderGBA.
//If you do not make UPS with FEBuilderGBA, please rewrite this string by yourself.
//ORG $DC110	//{J}
ORG $D74D0	//{U}
// BUILD_DATE: String("dd/mm/yyyy") ; BYTE 0, written by make (build_version_title_screen_date) only when the
// date changes, so the build leaves this tracked file alone and does not reassemble the ROM for it
#include "BuildDate.event"

POP

display_version:
ALIGN 4
#incbin "display_version.dmp"
POIN display_version_info

display_version_info:
BYTE 0x0  //X
BYTE 0x0  //Y
BYTE 0x9 //PAL
BYTE 0x01 //Show

ALIGN 4

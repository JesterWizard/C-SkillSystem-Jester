#ifndef DISTRICT_FISHING_INSTALLED
#define DISTRICT_FISHING_INSTALLED

/**
 * District fishing (WIZARDRY_CUSTOM, so FreeSpaceDEMO). Only included when CONFIG_DISTRICT_FISHING is defined (wizardry.event).
 * The A-press trap entry is in FreeMovement/cFreeMU/HookList.event, the trap loader case in TrapData/TrapData.c and the map
 * bobbers in EnterTown/DistrictNpc.c.
 */

/* Art: the scene, the sprites and the map bobber (generated by Tools/fishing/gen_fishing_art.py, data only). */
#include "Source/FishingArt.lyn.event"

/* The fishing screen (ProcScr_FishingScreen). */
#include "Source/FishingScreen.lyn.event"

/* The saved records shown in the prize table (a save chunk and a new-game hook in SaveData/data.event). */
#include "Source/FishingRecords.lyn.event"

/* The spot's A-press handler, its event, the map fade wrapper and the map bobbers. */
#include "Source/FishingDistrict.lyn.event"

#endif /* DISTRICT_FISHING_INSTALLED */

#ifndef DISTRICT_CROSSING_INSTALLED
#define DISTRICT_CROSSING_INSTALLED

/**
 * District River Crossing (WIZARDRY_CUSTOM, so FreeSpaceDEMO). Only included when CONFIG_DISTRICT_CROSSING is defined
 * (wizardry.event). The A-press trap entry is in FreeMovement/cFreeMU/HookList.event, the trap loader case in
 * TrapData/TrapData.c, the map flags in EnterTown/DistrictNpc.c and the records chunk in SaveData/data.event.
 */

/* Art: the scene, the sprites, the pop-up words and the map flag (generated by Tools/crossing/gen_crossing_art.py). */
#include "Source/CrossingArt.lyn.event"

/* The game (ProcScr_CrossingScreen). */
#include "Source/CrossingScreen.lyn.event"

/* The saved best scores. */
#include "Source/CrossingRecords.lyn.event"

/* The spot's A-press handler, its event, the map fade wrapper and the map flags. */
#include "Source/CrossingDistrict.lyn.event"

#endif /* DISTRICT_CROSSING_INSTALLED */

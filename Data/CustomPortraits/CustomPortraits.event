#include "PortraitTable.event"

#define setMugEntry_Halfbody(mugEntry, mugLocation, mouthX, mouthY, eyeX, eyeY) "PUSH; ORG PortraitTable+mugEntry*0x1C; POIN mugLocation; POIN mugLocation+0x2644; POIN mugLocation+0x2604; POIN mugLocation+0x2004; WORD 0x00000000; BYTE mouthX mouthY eyeX eyeY; WORD 0x01; POP"
#define setMugEntry_Halfbody(mugEntry, mugLocation, mouthX, mouthY, eyeX, eyeY, eyeControl) "PUSH; ORG PortraitTable+mugEntry*0x1C; POIN mugLocation; POIN mugLocation+0x2648; POIN mugLocation+0x2608; POIN mugLocation+0x2008; WORD 0x00000000; BYTE mouthX mouthY eyeX eyeY; WORD eyeControl; POP"

ALIGN 4
// 32-color mugs: PortraitFormatter32 + setMugEntry_32Color.
// pal1 overlay uses the paired face VRAM/pal bank (see Documentation/Features/Portrait32Color.md).
// Portrait_0x02:
//    #incext PortraitFormatter32 "Portraits/eirika_32.png"
// setMugEntry_32Color(0x02,Portrait_0x02,2,6,3,4)

// Portrait_0x51:
//    #incext HalfbodyFormatter "Portraits/Anna.png"
// setMugEntry_Halfbody(0x51,Portrait_0x51,3,7,3,5)

Portrait_0x1B:
   #incext PortraitFormatter "Portraits/gerik_dark_skin.png"
setMugEntry(0x1B,Portrait_0x1B,2,4,3,2)

Portrait_0x1C:
   #incext PortraitFormatter "Portraits/tethys_dark_skin.png"
setMugEntry(0x1C,Portrait_0x1C,2,6,3,4)

Portrait_0x1E:
   #incext PortraitFormatter "Portraits/marisa_dark_skin.png"
setMugEntry(0x1E,Portrait_0x1E,2,6,3,4)

Portrait_0x21:
   #incext PortraitFormatter "Portraits/ewan_dark_skin.png"
setMugEntry(0x21,Portrait_0x21,3,7,3,5)

Portrait_0x2A:
   #incext PortraitFormatter "Portraits/joshua_dark_skin.png"
setMugEntry(0x2A,Portrait_0x2A,2,5,3,3)

Portrait_0x3B:
   #incext PortraitFormatter "Portraits/aias_dark_skin.png"
setMugEntry(0x3B,Portrait_0x3B,2,5,3,3)

Portrait_0x3C:
   #incext PortraitFormatter "Portraits/carlyle_dark_skin.png"
setMugEntry(0x3C,Portrait_0x3C,2,5,3,3)

Portrait_0x43:
   #incext PortraitFormatter "Portraits/caellach_dark_skin.png"
setMugEntry(0x43,Portrait_0x43,2,5,3,3)

Portrait_0x56:
   #incext PortraitFormatter "Portraits/ismaire_dark_skin.png"
setMugEntry(0x56,Portrait_0x56,2,6,3,4)

Portrait_0x65:
   #incext PortraitFormatter "Portraits/armory.png"
setMugEntry(0x65,Portrait_0x65,3,2,3,3)

Portrait_0x66:

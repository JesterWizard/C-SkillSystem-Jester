#include "EAstdlib.event"
// #include "../../../PListSplit.event"

ALIGN 4
MapData:
  #incbin "Serafew_map_data.dmp"

// SetChapterData(0x3B, 0x0E, 0, 0x0F, 0x10, 0xCA, MapData, 0x12, 0, 0xCB)

ALIGN 4
Map_Change_0: SHORT $B90 $B94 $C88 $C10 $C14 $D08
Map_Change_1: SHORT $B90 $B94 $C88 $C10 $C14 $D08
Map_Change_2: SHORT $B90 $B94 $C88 $C10 $C14 $D08
Map_Change_3: SHORT $C88 $B94 $B98 $D08 $C14 $C18
Map_Change_4: SHORT $80
Map_Change_5: SHORT $80
Map_Change_6: SHORT $80
Map_Change_7: SHORT $80

ALIGN 4
MapChangesData:
  TileMap(0, 4, 0, 3, 2, Map_Change_0)
  TileMap(1, 4, 5, 3, 2, Map_Change_1)
  TileMap(2, 11, 9, 3, 2, Map_Change_2)
  TileMap(3, 11, 18, 3, 2, Map_Change_3)
  TileMap(4, 5, 1, 1, 1, Map_Change_4)
  TileMap(5, 5, 6, 1, 1, Map_Change_5)
  TileMap(6, 12, 10, 1, 1, Map_Change_6)
  TileMap(7, 12, 19, 1, 1, Map_Change_7)
  TileMapEnd
  
EventPointerTable(0xCB, MapChangesData)


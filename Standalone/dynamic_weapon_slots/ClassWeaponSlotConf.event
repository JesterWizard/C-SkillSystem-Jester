/* Edit this file without recompiling C.
 *
 * Each entry is 17 bytes:
 *   BYTE jid
 *   BYTE wtype slot0..7   (DWS_SLOT_NONE = unused)
 *   BYTE baseRank slot0..7 (0 = fall back to ClassData.baseRanks[slot])
 *
 * Classes not listed keep vanilla identity mapping (slot N stores weapon type N).
 * End the table with DWS_ClassWeaponSlotConfEnd.
 */

#define DWS_SLOT_NONE $FF

/* Weapon types (vanilla IDs) */
#define DWS_ITYPE_SWORD  0
#define DWS_ITYPE_LANCE  1
#define DWS_ITYPE_AXE    2
#define DWS_ITYPE_BOW    3
#define DWS_ITYPE_STAFF  4
#define DWS_ITYPE_ANIMA  5
#define DWS_ITYPE_LIGHT  6
#define DWS_ITYPE_DARK   7
#define DWS_ITYPE_KNIFE  $B
#define DWS_ITYPE_GUN    $C

/* Starting WEXP values */
#define DWS_WPN_EXP_E 1
#define DWS_WPN_EXP_D 31
#define DWS_WPN_EXP_C 71
#define DWS_WPN_EXP_B 121
#define DWS_WPN_EXP_A 161
#define DWS_WPN_EXP_S 241

/* Class IDs (FE8U) */
#define DWS_CLASS_THIEF      $0D
#define DWS_CLASS_ASSASSIN   $17
#define DWS_CLASS_ASSASSIN_F $18
#define DWS_CLASS_ROGUE      $33

#define DWS_ClassWeaponSlotConf(jid, w0, w1, w2, w3, w4, w5, w6, w7, br0, br1, br2, br3, br4, br5, br6, br7) \
    "BYTE jid; BYTE w0 w1 w2 w3 w4 w5 w6 w7; BYTE br0 br1 br2 br3 br4 br5 br6 br7"

#define DWS_ClassWeaponSlotConfEnd "BYTE 0"

/* Thief line: swords in slot 0, knives in slot 1 */
DWS_ClassWeaponSlotConf(DWS_CLASS_THIEF,      DWS_ITYPE_SWORD, DWS_ITYPE_KNIFE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, 0, DWS_WPN_EXP_E, 0, 0, 0, 0, 0, 0)
DWS_ClassWeaponSlotConf(DWS_CLASS_ASSASSIN,   DWS_ITYPE_SWORD, DWS_ITYPE_KNIFE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, 0, DWS_WPN_EXP_E, 0, 0, 0, 0, 0, 0)
DWS_ClassWeaponSlotConf(DWS_CLASS_ASSASSIN_F, DWS_ITYPE_SWORD, DWS_ITYPE_KNIFE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, 0, DWS_WPN_EXP_E, 0, 0, 0, 0, 0, 0)
DWS_ClassWeaponSlotConf(DWS_CLASS_ROGUE,      DWS_ITYPE_SWORD, DWS_ITYPE_KNIFE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, DWS_SLOT_NONE, 0, DWS_WPN_EXP_E, 0, 0, 0, 0, 0, 0)

DWS_ClassWeaponSlotConfEnd

#ifndef BIOGRAPHY_MAP_MENU
#define BIOGRAPHY_MAP_MENU

// Vanilla FE8U map-menu commands (gMapMenuItems at $59CE6C), byte-for-byte.
#define MM_Unit "BYTE $DC $7E $0D $08 $9A $06 $DF $06 $00 $6E $00 $00 $49 $F4 $04 $08 $00 $00 $00 $00 $0D $26 $02 $08 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00"
#define MM_Status "BYTE $D4 $7E $0D $08 $90 $06 $E0 $06 $00 $6F $00 $00 $49 $F4 $04 $08 $00 $00 $00 $00 $51 $26 $02 $08 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00"
#define MM_Guide "BYTE $CC $7E $0D $08 $9C $06 $E5 $06 $04 $74 $00 $00 $61 $26 $02 $08 $79 $26 $02 $08 $E5 $26 $02 $08 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00"
#define MM_Records "BYTE $C4 $7E $0D $08 $9E $06 $E3 $06 $00 $70 $00 $00 $41 $4C $02 $08 $00 $00 $00 $00 $BD $4C $02 $08 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00"
#define MM_Options "BYTE $BC $7E $0D $08 $9B $06 $E1 $06 $00 $71 $00 $00 $49 $F4 $04 $08 $00 $00 $00 $00 $29 $26 $02 $08 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00"
#define MM_Retreat "BYTE $B4 $7E $0D $08 $9D $06 $E2 $06 $00 $72 $00 $00 $CD $4C $02 $08 $00 $00 $00 $00 $E1 $4C $02 $08 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00"
#define MM_Suspend "BYTE $AC $7E $0D $08 $9F $06 $E4 $06 $00 $73 $00 $00 $B1 $25 $02 $08 $00 $00 $00 $00 $D1 $25 $02 $08 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00"
#define MM_End "BYTE $A4 $7E $0D $08 $A0 $06 $E6 $06 $00 $78 $00 $00 $49 $F4 $04 $08 $00 $00 $00 $00 $F9 $25 $02 $08 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00 $00"
#define MM_Separator "WORD 0 0 0 0 0 0 0 0 0"

ALIGN 4
BiographyCommandName:
String(" Biography")
BYTE 0

// Same order as the integrated C Skill System map menu: the command sits
// after Guide and before Records. Move the Biography block to reorder it.
ALIGN 4
gMapMenuItems_Biography:
MM_Unit
MM_Status
MM_Guide
POIN BiographyCommandName  // name (drawn as-is because nameMsgId is 0)
SHORT 0 TEXT_BIOGRAPHY_HELP // nameMsgId, helpMsgId (R-button help)
BYTE 4 $74                 // color (4 = green, like Guide), overrideId
SHORT 0
WORD $0804F449           // isAvailable: vanilla MenuAlwaysEnabled
WORD 0                     // onDraw: vanilla default
POIN MapMenu_BiographyCommand
WORD 0 0 0
MM_Records
MM_Options
MM_Retreat
MM_Suspend
MM_End
MM_Separator

#endif // BIOGRAPHY_MAP_MENU

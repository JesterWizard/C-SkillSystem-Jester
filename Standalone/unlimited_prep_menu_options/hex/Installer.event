/* Hex (standalone add-on, FE8U clean ROM). INSTALL THE PARENT PATCH FIRST:
 *   ../Installer.event (Unlimited Prep Menu Options), in the same Insert EA run, before this file.
 * Then this file. Do not define jumpToHack here; Insert EA provides it.
 * This add-on writes the card item into vanilla item slot HEX_CARD_ITEM, hooks GetItemName and
 * GetItemDescId, puts its body (cards, art, engine, Hex screen) at FE8U_HexFreeSpace (not $1000000,
 * which the parent uses), and adds the "Hex" row to the Preparations menu in extension slot HEX_PREP_SLOT. */

/* The Preparations menu extension slot (0 to 7) of the Hex row. Must equal HEX_PREP_SLOT in Source/Hex.h. */
#define HEX_PREP_SLOT                      0

/* Vanilla addresses (ROM offset = address - 0x08000000). All are 4-byte aligned. */
#define FE8U_gItemData                     $809B10  /* gItemData: 36 bytes per item, 0x00..0xCD (0x080177B0 GetItemData) */
#define FE8U_GetItemName                   $174F4   /* 0x080174F4 */
#define FE8U_GetItemDescId                 $17518   /* 0x08017518 */

/* The vanilla item slot used for cards: "Dummy" (name text 0x0403). Must equal HEX_CARD_ITEM in Source/Hex.h. */
#define HEX_CARD_ITEM                      $C1

/* Icon byte of the card (vanilla item icon at +0x1D). $84 is the vanilla "Member Card" icon
 * (item $72, a card). Member Card's row has icon $84 at +0x1D and 0 at +0x1E. $85 is "Silver Card". */
#define ICON_CARD                          $84

/* Free space for this add-on's body. The parent uses $1000000..$1001060. */
#define FE8U_HexFreeSpace                  $1100000

/* Item row: gItemData[HEX_CARD_ITEM] (struct ItemData, 36 bytes). Only the card's fields are
 * set; the rest is zero. The name and description ids are the dummy item's own (the hook
 * shows the character's text instead). */
PUSH
ORG FE8U_gItemData + HEX_CARD_ITEM * 36
    SHORT 0x0403 0x04AB 0x0000      // nameTextId (MSG_403 "Dummy", hooked), descTextId (MSG_04AB), useDescTextId
    BYTE HEX_CARD_ITEM 0x09         // number, weaponType = ITYPE_ITEM (9)
    WORD 0x00000008                 // attributes = IA_UNBREAKABLE (1 << 3): GetItemUses returns 0xFF, shown blank
    WORD 0x00000000 0x00000000      // pStatBonuses, pEffectiveness (NULL)
    BYTE 0x01 0x00 0x00 0x00 0x00 0x00 // maxUses 1, might, hit, weight, crit, encodedRange
    SHORT 0x0000                    // costPerUse 0
    BYTE 0x00 ICON_CARD             // weaponRank (0x1C), icon (0x1D): vanilla GetItemIconId (0x08017700) reads this byte
    BYTE 0x00 0x00                  // useEffectId (0x1E, 0 = no use: GetItemUseEffect 0x0801773C), weaponEffectId (0x1F)
    BYTE 0x00 0x00 0x00 0x00        // 0x20..0x23: zero (the bytes after the effects in Member Card's row)
    PROTECT FE8U_gItemData + HEX_CARD_ITEM * 36 FE8U_gItemData + HEX_CARD_ITEM * 36 + 36 // item row
POP

/* Hooks: jumpToHack at the vanilla function (8 bytes: ldr r3,[pc]; bx r3; pointer). */
PUSH
ORG FE8U_GetItemName
    jumpToHack(HexItem_GetItemName)
    PROTECT FE8U_GetItemName FE8U_GetItemName + 0x8 // GetItemName hook
POP

PUSH
ORG FE8U_GetItemDescId
    jumpToHack(HexItem_GetItemDescId)
    PROTECT FE8U_GetItemDescId FE8U_GetItemDescId + 0x8 // GetItemDescId hook
POP

/* Body: the card helpers, the rules engine, the card art, the Preparations row and the Hex screen
 * (Source/Hex.lyn.event, made by `make` in this folder). Everything is protected. */
PUSH
ORG FE8U_HexFreeSpace
#include "Source/Hex.lyn.event"
PROTECT FE8U_HexFreeSpace CURRENTOFFSET // body
POP

/* The Hex row: the parent's extension slot HEX_PREP_SLOT points at HexPrepRow (a struct PrepMenuExtRow in the body).
 * The slot words at $1000004..$1000023 are not protected in the parent, so this write is allowed. */
PUSH
ORG $1000004 + 4*HEX_PREP_SLOT
POIN HexPrepRow
POP

#define FE8U_Title_IDLE               $C6354
#define FE8U_LoadSavedEid8A           $A5290

PUSH
ORG FE8U_Title_IDLE
    jumpToHack(Title_IDLE_Konami)
    PROTECT FE8U_Title_IDLE FE8U_Title_IDLE + 0x8 // Title_IDLE hook

ORG FE8U_LoadSavedEid8A
    jumpToHack(LoadSavedEid8A_Always)
    PROTECT FE8U_LoadSavedEid8A FE8U_LoadSavedEid8A + 0x8 // LoadSavedEid8A hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_konami_style_bonus_screen:
#include "Source/KonamiCode.lyn.event"
PROTECT StandaloneBody_konami_style_bonus_screen CURRENTOFFSET // KonamiCode body

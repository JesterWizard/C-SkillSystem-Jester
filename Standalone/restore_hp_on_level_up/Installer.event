#define FE8U_BattleApplyUnitUpdates $2C028

/* Edit without recompiling C. */
#define RESTORE_HP_ON_LEVEL_UP 1

PUSH
ORG FE8U_BattleApplyUnitUpdates
    jumpToHack(BattleApplyUnitUpdates_RestoreHp)
    PROTECT FE8U_BattleApplyUnitUpdates FE8U_BattleApplyUnitUpdates + 0x8 // BattleApplyUnitUpdates hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_restore_hp_on_level_up:
#include "Source/RestoreHpOnLevelUp.lyn.event"

ALIGN 4
RestoreHpOnLevelUpEnabled:
BYTE RESTORE_HP_ON_LEVEL_UP

PROTECT StandaloneBody_restore_hp_on_level_up CURRENTOFFSET // RestoreHpOnLevelUp body + config

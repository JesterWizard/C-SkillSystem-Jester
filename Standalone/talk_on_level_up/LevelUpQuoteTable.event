/* row indexes map to LVUP_QUOTE_ID(row*3 + tier). */
#define LevelUpQuoteRow(charId, row) "BYTE charId 0 0 0; WORD LVUP_QUOTE_ID((row)*3) LVUP_QUOTE_ID((row)*3+1) LVUP_QUOTE_ID((row)*3+2)"


#include "EAstdlib.event"
#include "Extensions/Hack Installation.txt"
#include "Tools/Tool Helpers.txt"

#define FE8U_StartManimLevelUp   $7F10C
#define FE8U_StandaloneFreeSpace $1000000

#define LVUP_TEXT_BASE   $1000
#define LVUP_QUOTE_COUNT 135
#define LVUP_QUOTE_ID(index) (LVUP_TEXT_BASE + index)
#define setLvupText(index, label) "PUSH; ORG (TextTable+4*(LVUP_TEXT_BASE+index)); POIN (label | 0x80000000); POP"

PUSH
ORG FE8U_StartManimLevelUp
    jumpToHack(StartManimLevelUp_TalkOnLevelUp)
    PROTECT FE8U_StartManimLevelUp FE8U_StartManimLevelUp + 0x8 // StartManimLevelUp hook
POP

ORG FE8U_StandaloneFreeSpace
#include "Source/TalkOnLevelUp.lyn.event"
#include "LevelUpQuotes.event"
#include "LevelUpQuoteTable.event"
PROTECT FE8U_StandaloneFreeSpace CURRENTOFFSET // TalkOnLevelUp body + quotes + table

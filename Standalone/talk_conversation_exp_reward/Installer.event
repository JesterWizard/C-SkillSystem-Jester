#define FE8U_CallMapSupportEvent  $D304

PUSH
ORG FE8U_CallMapSupportEvent
    jumpToHack(CallMapSupportEvent_ExpReward)
    PROTECT FE8U_CallMapSupportEvent FE8U_CallMapSupportEvent + 0x8 // CallMapSupportEvent hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_talk_conversation_exp_reward:

ALIGN 4
gSupportTalkExpReward:
    BYTE 10 // EXP the unit who used the Support command gains after the conversation (0-100, 0 = off)

ALIGN 4
#include "Source/SupportTalkExpReward.lyn.event"
PROTECT StandaloneBody_talk_conversation_exp_reward CURRENTOFFSET // SupportTalkExpReward body

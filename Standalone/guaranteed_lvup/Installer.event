#define FE8U_CheckBattleUnitLevelUp $2BA28

PUSH
ORG FE8U_CheckBattleUnitLevelUp
    jumpToHack(CheckBattleUnitLevelUp_Guaranteed)
    PROTECT FE8U_CheckBattleUnitLevelUp FE8U_CheckBattleUnitLevelUp + 0x8 // CheckBattleUnitLevelUp hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_guaranteed_lvup:
#include "Source/CheckBattleUnitLevelUp_Guaranteed.lyn.event"
PROTECT StandaloneBody_guaranteed_lvup CURRENTOFFSET // CheckBattleUnitLevelUp_Guaranteed body

#define FE8U_WorldMap_LoopExt $B96F8
#define FE8U_StartWMNodeMenu  $BC5B4

PUSH
ORG FE8U_WorldMap_LoopExt
    jumpToHack(WorldMap_LoopExt_ThoughtBubbles)
    PROTECT FE8U_WorldMap_LoopExt FE8U_WorldMap_LoopExt + 0x8 // WorldMap_LoopExt hook
ORG FE8U_StartWMNodeMenu
    jumpToHack(StartWMNodeMenu_ThoughtBubbles)
    PROTECT FE8U_StartWMNodeMenu FE8U_StartWMNodeMenu + 0x8 // StartWMNodeMenu hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_world_map_thought_bubbles:
#include "Source/WorldMapThoughts.lyn.event"
#include "Gfx.event"
PROTECT StandaloneBody_world_map_thought_bubbles CURRENTOFFSET // WorldMapThoughts body + graphics

#define FE8U_PopupIconUpdateProc_Loop $11254

PUSH
ORG FE8U_PopupIconUpdateProc_Loop
    jumpToHack(PopupIconUpdateProc_Loop_Shine)
    PROTECT FE8U_PopupIconUpdateProc_Loop FE8U_PopupIconUpdateProc_Loop + 0x8 // PopupIconUpdateProc_Loop hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_popup_item_icon_shine:
#include "Source/PopupIconShine.lyn.event"

PROTECT StandaloneBody_popup_item_icon_shine CURRENTOFFSET // PopupIconShine body

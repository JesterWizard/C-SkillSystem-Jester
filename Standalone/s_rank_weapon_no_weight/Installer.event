#define FE8U_ComputeBattleUnitSpeed $2AB74

PUSH
ORG FE8U_ComputeBattleUnitSpeed
    jumpToHack(ComputeBattleUnitSpeed_SRankNoWeight)
    PROTECT FE8U_ComputeBattleUnitSpeed FE8U_ComputeBattleUnitSpeed + 0x8 // ComputeBattleUnitSpeed hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_s_rank_weapon_no_weight:
#include "Source/SRankWeaponNoWeight.lyn.event"
PROTECT StandaloneBody_s_rank_weapon_no_weight CURRENTOFFSET // SRankWeaponNoWeight body

#define FE8U_PutUnitSpriteIconsOam     $275E8
#define FE8U_MapTask_PutUnitSpritesOam $59D934

PUSH
ORG FE8U_PutUnitSpriteIconsOam
    SHORT $B5F0 $4657 $464E $4645 // vanilla prologue (undo any old jumpToHack here, which would recurse)
    PROTECT FE8U_PutUnitSpriteIconsOam FE8U_PutUnitSpriteIconsOam + 0x8 // PutUnitSpriteIconsOam vanilla restore
ORG FE8U_MapTask_PutUnitSpritesOam
    POIN PutUnitSpritesOam_CustomDroppableItemIcon
    PROTECT FE8U_MapTask_PutUnitSpritesOam FE8U_MapTask_PutUnitSpritesOam + 0x4 // MapTask PutUnitSpritesOam
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_custom_droppable_item_icon:
#include "Source/CustomDroppableItemIcon.lyn.event"
PROTECT StandaloneBody_custom_droppable_item_icon CURRENTOFFSET // PutUnitSpritesOam_CustomDroppableItemIcon body

#include "Gfx.event"

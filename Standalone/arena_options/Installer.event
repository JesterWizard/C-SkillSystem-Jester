// Arena options for FE8U: the C Skill System arena module's
// arena_let_player_use_upgraded_weapons, arena_calculate_weapon_based_on_level,
// arena_limits and arena_roster_menu flags. See README.md.

// Settings ------------------------------------------------------------------
// Each option installs its own hook. Put // in front of a #define to leave
// that option (and its hook) out.

// Upgraded player weapon: the player fights with a better weapon than the
// vanilla iron tier (only tiers the unit can wield).
//   ARENA_WEAPON_UPGRADE 1 = one tier up (Iron -> Steel, Fire -> Elfire, ...)
//   ARENA_WEAPON_UPGRADE 2 = tier from level: unpromoted 1-10 iron,
//                            11-20 steel, promoted silver
#define ARENA_UPGRADED_WEAPONS
#define ARENA_WEAPON_UPGRADE 2

// Arena limits: per-chapter turn and level limits (table below). A unit over
// the limit sees the Arena command greyed out; selecting it shows why.
// #define ARENA_LIMITS
#define ARENA_LIMIT_PROMOTED_BONUS 20   // levels added for promoted units

// Arena roster menu: in chapters listed in the roster table below, the arena
// shows a list of fixed opponents to pick from instead of a random one.
// Beaten opponents are greyed out until the next chapter.
// #define ARENA_ROSTER_MENU
#define ARENA_ROSTER_SHOW_OPPONENT 1    // 1 = opponent window before the wager
#define ARENA_ROSTER_FIRST_FLAG 0x21    // chapter flags 0x21.. mark beaten entries
// ---------------------------------------------------------------------------

#define FE8U_ArenaCommandUsability    $240EC
#define FE8U_ArenaCommandEffect       $24144
#define FE8U_ArenaGenerateBaseWeapons $31B70
#define FE8U_StartArenaScreen         $B576C
#define FE8U_StandaloneFreeSpace      $1000000

#ifdef ARENA_UPGRADED_WEAPONS
PUSH
ORG FE8U_ArenaGenerateBaseWeapons
    jumpToHack(ArenaGenerateBaseWeapons_Options)
    PROTECT FE8U_ArenaGenerateBaseWeapons FE8U_ArenaGenerateBaseWeapons + 0x8 // ArenaGenerateBaseWeapons hook
POP
#endif

#ifdef ARENA_LIMITS
PUSH
ORG FE8U_ArenaCommandUsability
    jumpToHack(ArenaCommandUsability_Limits)
    PROTECT FE8U_ArenaCommandUsability FE8U_ArenaCommandUsability + 0x8 // ArenaCommandUsability hook
ORG FE8U_ArenaCommandEffect
    jumpToHack(ArenaCommandEffect_Limits)
    PROTECT FE8U_ArenaCommandEffect FE8U_ArenaCommandEffect + 0x8 // ArenaCommandEffect hook
POP
#endif

#ifdef ARENA_ROSTER_MENU
PUSH
ORG FE8U_StartArenaScreen
    jumpToHack(StartArenaScreen_Roster)
    PROTECT FE8U_StartArenaScreen FE8U_StartArenaScreen + 0x8 // StartArenaScreen hook
POP
#endif

ORG FE8U_StandaloneFreeSpace
#include "Source/ArenaOptions.lyn.event"

ALIGN 4
gArenaOptionsConfig:
BYTE ARENA_WEAPON_UPGRADE ARENA_ROSTER_SHOW_OPPONENT ARENA_ROSTER_FIRST_FLAG ARENA_LIMIT_PROMOTED_BONUS

// Arena limits table ----------------------------------------------------------
// ArenaLimit(chapter, level limit, turn limit); 0 = no limit of that kind.
// Level limit compares level (+ ARENA_LIMIT_PROMOTED_BONUS if promoted).
// Chapters not listed have no limits.
#define ArenaLimit(chapter, levelLimit, turnLimit) "BYTE chapter levelLimit turnLimit"
#define ArenaLimitEnd "BYTE 0xFF 0xFF 0xFF"

ALIGN 4
gArenaLimitTable:
ArenaLimit(6, 5, 3)  // Chapter 6: level 5 or lower, turns 1-3 only
ArenaLimitEnd

// Arena roster table ----------------------------------------------------------
// ArenaRosterChapter(chapter, wins until "cleaned out" (0 = none), entry count, entry list)
// ArenaRosterEntry(character, class, level, reward type, weapon, wager, reward item)
//   character 0 = generic arena fighter (the list shows the class name)
//   reward type 0 = 2x wager, 1 = 3x wager, 2 = reward item
// Entry N of a chapter uses chapter flag ARENA_ROSTER_FIRST_FLAG + N to
// remember it was beaten: keep those flags unused by the chapter's events.
// FE8U stores chapter flags 1-0x28, so at most 0x29 - ARENA_ROSTER_FIRST_FLAG
// entries per chapter are used (8 with the default 0x21).
#define ArenaRosterChapter(chapter, maxWins, count, entries) "BYTE chapter maxWins count 0; POIN entries"
#define ArenaRosterChapterEnd "BYTE 0xFF 0 0 0; WORD 0"
#define ArenaRosterEntry(pid, jid, level, rewardType, item, price, reward) "BYTE pid jid level rewardType; SHORT item price reward"

ALIGN 4
gArenaRosterTable:
ArenaRosterChapter(6, 6, 6, ArenaRosterChapter6)
ArenaRosterChapterEnd

ALIGN 4
ArenaRosterChapter6:
ArenaRosterEntry(0x20, 0x13, 5, 2, 0x0D, 900, 0x91)  // Joshua (Myrmidon) with a Killing Edge; prize Audhulma
ArenaRosterEntry(0x00, 0x0F, 6, 1, 0x01, 500, 0)     // Mercenary, Iron Sword; 3x wager
ArenaRosterEntry(0x00, 0x3F, 5, 0, 0x1F, 480, 0)     // Fighter, Iron Axe; 2x wager
ArenaRosterEntry(0x00, 0x19, 5, 2, 0x2D, 460, 0x2D)  // Archer, Iron Bow; prize Iron Bow
ArenaRosterEntry(0x00, 0x4E, 5, 0, 0x14, 440, 0)     // Soldier, Iron Lance; 2x wager
ArenaRosterEntry(0x00, 0x07, 5, 0, 0x14, 440, 0)     // Paladin, Iron Lance; 2x wager

PROTECT FE8U_StandaloneFreeSpace CURRENTOFFSET // ArenaOptions body + config + tables

// Text Engine for FE8U: the C Skill System's dialogue text engine rework,
// itself a C port of Tequila's text engine hack (with help from Zahlman).
// See README.md for the control codes, hooks, RAM and conflicts.

// Settings ------------------------------------------------------------------
// Conversation log: remove the // in front of the next line to install it.
// SELECT during dialogue then opens a scrollback log of the chapter's
// dialogue (UP/DOWN scroll, SELECT closes). It adds two hooks.
// #define TEXT_ENGINE_CHATLOG
//
// Half-body and 32-colour portraits (Standalone/portrait_formats, through the
// text engine): remove the // in front of the next line to install them.
// Portraits made with that package's tools and macros then show in dialogue
// and menus; other portraits stay as they are. It adds 11 hooks and a few
// byte changes (listed in README.md). Don't also install
// Standalone/portrait_formats.
// #define TEXT_ENGINE_HALF_BODY_PORTRAITS
//
// Free EWRAM the patch keeps its state in. Change an address if another patch
// in your ROM already uses that range. Each must be a multiple of 4.
#ifndef TEXT_ENGINE_RAM
    #define TEXT_ENGINE_RAM          0x0203AB00 // 0x1A0 bytes
#endif
#ifndef TEXT_ENGINE_CHATLOG_RAM
    #define TEXT_ENGINE_CHATLOG_RAM  0x0203B000 // 0x600 bytes, only with TEXT_ENGINE_CHATLOG
#endif
#ifndef TEXT_ENGINE_PORTRAIT_RAM
    #define TEXT_ENGINE_PORTRAIT_RAM 0x0203B800 // 0xA0 bytes, only with TEXT_ENGINE_HALF_BODY_PORTRAITS
#endif
// ---------------------------------------------------------------------------

#define FE8U_ClassChgLoadUI                 $CCBF4
#define FE8U_FaceBlink_PutSprite            $5FE0   // sub_8005FE0
#define FE8U_FaceBlink_PutEyes              $6134   // sub_8006134
#define FE8U_InitTalk                       $680C
#define FE8U_Talk_OnInit                    $6C00
#define FE8U_Talk_OnIdle                    $6C34
#define FE8U_TalkPrepNextChar_BoxWidth      $6DC4   // inside TalkPrepNextChar
#define FE8U_ChangeTextColorID              $6F00   // sub_8006F00
#define FE8U_TalkInterpret                  $6FD0
#define FE8U_StartTalkFaceMove              $7A58
#define FE8U_TalkFaceMove_OnInit            $7AB0
#define FE8U_Talk_OnEnd                     $7C0C
#define FE8U_TalkShiftClearAll_OnInit       $7D38
#define FE8U_TalkShiftClear_OnInit          $7F9C
#define FE8U_StartOpenTalkBubble_ProcScr    $83F4   // literal: gProcScr_TalkBubbleOpen
#define FE8U_StartTalkOpen                  $88A8
#define FE8U_GetTalkFaceHPos                $8934
#define FE8U_GetStrTalkLen                  $8B44
#define FE8U_TalkSkipListener_OnIdle        $6B4C   // chatlog only
#define FE8U_TalkWaitForInput_OnIdle        $7C4C   // chatlog only
#define FE8U_Face_OnIdle                    $55BC
// TEXT_ENGINE_HALF_BODY_PORTRAITS only:
#define FE8U_Face_OnInit                    $5594
#define FE8U_StartFaceAuto                  $5610
#define FE8U_StartFace                      $563C
#define FE8U_EndFace                        $5738
#define FE8U_FaceRefreshSprite              $57C0
#define FE8U_PutFace80x72_Core              $5CA4
#define FE8U_StartFaceFadeIn                $5EF0
#define FE8U_StartFaceFadeOut               $5F38
#define FE8U_StartFace2                     $64F4
#define FE8U_FaceChange_LoadGfx             $6650   // sub_8006650
#define FE8U_PutTalkBubble                  $82A4
#define FE8U_StandaloneFreeSpace            $1000000

// A 16-byte hook for functions with four or more arguments, which
// jumpToHack can't take (it uses r3).  bx pc; nop; ldr r12, [pc]; bx r12.
#define hookViaR12(target) "BYTE 0x78 0x47 0xC0 0x46; WORD 0xE59FC000 0xE12FFF1C; POIN target"

PUSH
ORG FE8U_ClassChgLoadUI
    jumpToHack(ClassChgLoadUI_C)
    PROTECT FE8U_ClassChgLoadUI FE8U_ClassChgLoadUI + 0x8 // ClassChgLoadUI
ORG FE8U_FaceBlink_PutSprite
    jumpToHack(sub_8005FE0)
    PROTECT FE8U_FaceBlink_PutSprite FE8U_FaceBlink_PutSprite + 0x8 // sub_8005FE0
ORG FE8U_FaceBlink_PutEyes
    jumpToHack(sub_8006134)
    PROTECT FE8U_FaceBlink_PutEyes FE8U_FaceBlink_PutEyes + 0x8 // sub_8006134
ORG FE8U_InitTalk
    jumpToHack(InitTalk_C)
    PROTECT FE8U_InitTalk FE8U_InitTalk + 0x8 // InitTalk
ORG FE8U_Talk_OnInit
    jumpToHack(Talk_OnInit_C)
    PROTECT FE8U_Talk_OnInit FE8U_Talk_OnInit + 0x8 // Talk_OnInit
ORG FE8U_Talk_OnIdle
    jumpToHack(Talk_OnIdle)
    PROTECT FE8U_Talk_OnIdle FE8U_Talk_OnIdle + 0x8 // Talk_OnIdle
ORG FE8U_TalkPrepNextChar_BoxWidth
    callHack_r3(UpdateFontBeforeBoxWidthCalc)
    SHORT 0x46C0
    PROTECT FE8U_TalkPrepNextChar_BoxWidth FE8U_TalkPrepNextChar_BoxWidth + 0xE // TalkPrepNextChar box width
ORG FE8U_ChangeTextColorID
    jumpToHack(ChangeTextColorID)
    PROTECT FE8U_ChangeTextColorID FE8U_ChangeTextColorID + 0x8 // sub_8006F00
ORG FE8U_TalkInterpret
    jumpToHack(TalkInterpret)
    PROTECT FE8U_TalkInterpret FE8U_TalkInterpret + 0x8 // TalkInterpret
ORG FE8U_StartTalkFaceMove
    jumpToHack(StartTalkFaceMove_C)
    PROTECT FE8U_StartTalkFaceMove FE8U_StartTalkFaceMove + 0x8 // StartTalkFaceMove
ORG FE8U_TalkFaceMove_OnInit
    jumpToHack(TalkFaceMove_OnInitOverride)
    PROTECT FE8U_TalkFaceMove_OnInit FE8U_TalkFaceMove_OnInit + 0x8 // TalkFaceMove_OnInit
ORG FE8U_Talk_OnEnd
    jumpToHack(Talk_OnEnd_C)
    PROTECT FE8U_Talk_OnEnd FE8U_Talk_OnEnd + 0x8 // Talk_OnEnd
ORG FE8U_TalkShiftClearAll_OnInit
    jumpToHack(TalkShiftClearAll_OnInit_C)
    PROTECT FE8U_TalkShiftClearAll_OnInit FE8U_TalkShiftClearAll_OnInit + 0x8 // TalkShiftClearAll_OnInit
ORG FE8U_TalkShiftClear_OnInit
    jumpToHack(TalkShiftClear_OnInit_C)
    PROTECT FE8U_TalkShiftClear_OnInit FE8U_TalkShiftClear_OnInit + 0x8 // TalkShiftClear_OnInit
ORG FE8U_StartOpenTalkBubble_ProcScr
    POIN gProc_DialogueBoxAppearingAnimation
    PROTECT FE8U_StartOpenTalkBubble_ProcScr FE8U_StartOpenTalkBubble_ProcScr + 0x4 // StartOpenTalkBubble proc
ORG FE8U_StartTalkOpen
    jumpToHack(StartTalkOpen_C)
    PROTECT FE8U_StartTalkOpen FE8U_StartTalkOpen + 0x8 // StartTalkOpen
ORG FE8U_GetTalkFaceHPos
    jumpToHack(GetTalkFaceHPos)
    PROTECT FE8U_GetTalkFaceHPos FE8U_GetTalkFaceHPos + 0x8 // GetTalkFaceHPos
ORG FE8U_GetStrTalkLen
    jumpToHack(GetStringTextWidthWithDialogueCodes)
    PROTECT FE8U_GetStrTalkLen FE8U_GetStrTalkLen + 0x8 // GetStrTalkLen
ORG FE8U_Face_OnIdle
    jumpToHack(Face_OnIdle_Portraits)
    PROTECT FE8U_Face_OnIdle FE8U_Face_OnIdle + 0x8 // Face_OnIdle
#ifdef TEXT_ENGINE_CHATLOG
ORG FE8U_TalkSkipListener_OnIdle
    jumpToHack(TalkSkipListener_OnIdle_Chatlog)
    PROTECT FE8U_TalkSkipListener_OnIdle FE8U_TalkSkipListener_OnIdle + 0x8 // TalkSkipListener_OnIdle
ORG FE8U_TalkWaitForInput_OnIdle
    jumpToHack(TalkWaitForInput_OnIdle_Chatlog)
    PROTECT FE8U_TalkWaitForInput_OnIdle FE8U_TalkWaitForInput_OnIdle + 0x8 // TalkWaitForInput_OnIdle
#endif
#ifdef TEXT_ENGINE_HALF_BODY_PORTRAITS
ORG FE8U_Face_OnInit
    jumpToHack(Face_OnInit_Portraits)
    PROTECT FE8U_Face_OnInit FE8U_Face_OnInit + 0x8 // Face_OnInit
ORG FE8U_StartFaceAuto
    hookViaR12(StartFaceAuto_Portraits)
    PROTECT FE8U_StartFaceAuto FE8U_StartFaceAuto + 0x10 // StartFaceAuto
ORG FE8U_StartFace
    hookViaR12(StartFace_Portraits)
    PROTECT FE8U_StartFace FE8U_StartFace + 0x10 // StartFace
ORG FE8U_EndFace
    jumpToHack(EndFace_Portraits)
    PROTECT FE8U_EndFace FE8U_EndFace + 0x8 // EndFace
ORG FE8U_FaceRefreshSprite
    jumpToHack(FaceRefreshSprite_Portraits)
    PROTECT FE8U_FaceRefreshSprite FE8U_FaceRefreshSprite + 0x8 // FaceRefreshSprite
ORG FE8U_PutFace80x72_Core
    hookViaR12(PutFace80x72_Core_Portraits)
    PROTECT FE8U_PutFace80x72_Core FE8U_PutFace80x72_Core + 0x10 // PutFace80x72_Core
ORG FE8U_StartFaceFadeIn
    jumpToHack(StartFaceFadeIn_Portraits)
    PROTECT FE8U_StartFaceFadeIn FE8U_StartFaceFadeIn + 0x8 // StartFaceFadeIn
ORG FE8U_StartFaceFadeOut
    jumpToHack(StartFaceFadeOut_Portraits)
    PROTECT FE8U_StartFaceFadeOut FE8U_StartFaceFadeOut + 0x8 // StartFaceFadeOut
ORG FE8U_StartFace2
    hookViaR12(StartFace2_Portraits)
    PROTECT FE8U_StartFace2 FE8U_StartFace2 + 0x10 // StartFace2
ORG FE8U_FaceChange_LoadGfx
    jumpToHack(FaceChange_LoadGfx_Portraits)
    PROTECT FE8U_FaceChange_LoadGfx FE8U_FaceChange_LoadGfx + 0x8 // sub_8006650
ORG FE8U_PutTalkBubble
    hookViaR12(PutTalkBubble_Portraits)
    PROTECT FE8U_PutTalkBubble FE8U_PutTalkBubble + 0x10 // PutTalkBubble
#include "Data/PortraitPatches.event"
#endif
POP

#include "Source/RamAlloc.event"

ORG FE8U_StandaloneFreeSpace

ALIGN 4
gTextEngineConfig:
    BYTE 1 // dim_listener_portraits: 1 = dim the portraits of characters who aren't speaking, 0 = off

ALIGN 4
#include "Source/TextEngine.lyn.event"

ALIGN 4
#include "Data/Tables.event"

ALIGN 4
#include "Data/Popups.event"

ALIGN 4
#ifdef TEXT_ENGINE_CHATLOG
    #include "Source/Chatlog.lyn.event"
#else
    #include "Source/ChatlogStubs.lyn.event"
#endif

ALIGN 4
#ifdef TEXT_ENGINE_HALF_BODY_PORTRAITS
    #include "Source/Portraits.lyn.event"
#else
    #include "Source/PortraitStubs.lyn.event"
#endif

PROTECT FE8U_StandaloneFreeSpace CURRENTOFFSET // TextEngine body and data

#define FE8U_GetUnitFogViewRange  $178A8
#define FE8U_gPlaySt              $0202BCF0

PUSH
ORG FE8U_GetUnitFogViewRange
    jumpToHack(CustomGetUnitFogViewRange)
    PROTECT FE8U_GetUnitFogViewRange FE8U_GetUnitFogViewRange + 0x8 // GetUnitFogViewRange hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_custom_fog_sight:
// CustomGetUnitFogViewRange(struct Unit * unit)
// r0 = unit on entry; returns fog range in r0.

ALIGN 4
CustomGetUnitFogViewRange:
SHORT $4B06 $6841 $7B5A $7909 $4B05 $5C5B $189B $2231 $5C82 $0712 $0F12 $1898 $4770 $46C0
WORD FE8U_gPlaySt
POIN ClassFogSightBonusTable

#include "ClassFogSightBonusTable.event"
PROTECT StandaloneBody_custom_fog_sight CURRENTOFFSET // CustomGetUnitFogViewRange body + bonus table

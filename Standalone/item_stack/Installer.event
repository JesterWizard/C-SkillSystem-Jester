#define TextTable        $15D48C
#define TEXT_STACK_DESC  $407
// Vanilla DecodeString has no anti-Huffman bit. Pointers must be Huffman-compressed.
#define setText(textID, offset) "PUSH; ORG TextTable + (4 * textID); POIN offset; PROTECT TextTable + (4 * textID) TextTable + (4 * textID) + 0x4; POP"

#define FE8U_UnitActionMenuItemsPtr $59D1F8

/* Edit without recompiling C. Keep in sync with STACK_HELP_TEXT in Source/StackCommand.c. */
#define ITEM_STACK 1

PUSH
ORG FE8U_UnitActionMenuItemsPtr
    POIN gUnitActionMenuItems_ItemStack
    PROTECT FE8U_UnitActionMenuItemsPtr FE8U_UnitActionMenuItemsPtr + 0x4 // gUnitActionMenuDef.menuItems
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_item_stack:
#include "Source/StackCommand.lyn.event"
#include "Menu.event"
#include "Text.event"

ALIGN 4
ItemStackEnabled:
BYTE ITEM_STACK

PROTECT StandaloneBody_item_stack CURRENTOFFSET // Item stack body + unit menu + text + config

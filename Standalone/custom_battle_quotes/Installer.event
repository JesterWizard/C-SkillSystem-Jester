#define FE8U_GetBattleQuoteEntry   $8464C

PUSH
ORG FE8U_GetBattleQuoteEntry
    jumpToHack(GetBattleQuoteEntry_Custom)
    PROTECT FE8U_GetBattleQuoteEntry FE8U_GetBattleQuoteEntry + 0x8 // GetBattleQuoteEntry hook
POP

// Free space: the body goes on from where this file starts. FEBuilder's Insert EA
// starts it in free space it finds in the ROM. With Event Assembler, ORG to free
// space before including this file (see README.md).
ASSERT CURRENTOFFSET - 1 // fails if nothing set free space: ORG to free space before including this file
ALIGN 4
StandaloneBody_custom_battle_quotes:
#include "Source/CustomBattleQuotes.lyn.event"
#include "BattleTalkTable.event"

PROTECT StandaloneBody_custom_battle_quotes CURRENTOFFSET // CustomBattleQuotes body + table

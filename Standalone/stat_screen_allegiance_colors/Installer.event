#define FE8U_StatScreen_LoadBgPal $8859C // inside StatScreen_InitDisplay: ldr r0, =Pal_StatscreenBG ...
#define FE8U_StandaloneFreeSpace  $1000000

PUSH
ORG FE8U_StatScreen_LoadBgPal
    jumpToHack(StatScreen_LoadBgPal_Allegiance)
    PROTECT FE8U_StatScreen_LoadBgPal FE8U_StatScreen_LoadBgPal + 0x8 // StatScreen_InitDisplay BG palette hook
POP

ORG FE8U_StandaloneFreeSpace
#include "Source/StatScreenAllegianceColors.lyn.event"

// Only the first 0x80 bytes (4 palettes, loaded to BG palettes 12-15) are used.
ALIGN 4
Pal_SSBlue:
    #incbin "Gfx/SSBluePal.dmp"

ALIGN 4
Pal_SSRed:
    #incbin "Gfx/SSRedPal.dmp"

ALIGN 4
Pal_SSGreen:
    #incbin "Gfx/SSGreenPal.dmp"

ALIGN 4
Pal_SSGold:
    #incbin "Gfx/SSGoldPal.dmp"

PROTECT FE8U_StandaloneFreeSpace CURRENTOFFSET // StatScreenAllegianceColors body + palettes

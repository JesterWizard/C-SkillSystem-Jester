SongTable(AUTO,[AUDIO_FILENAME],0) // Run assign_voice_song_ids.py to pick an unused song-table ID

    #define    loop_sfx_grp_[AUDIO_FILENAME]  [AUDIO_FILENAME]_map
    #define    loop_sfx_pri_[AUDIO_FILENAME]  0
    #define    loop_sfx_rev_[AUDIO_FILENAME]  0
    #define    loop_sfx_mvl_[AUDIO_FILENAME]  127
    #define    loop_sfx_key_[AUDIO_FILENAME]  0
    #define    loop_sfx_tbs_[AUDIO_FILENAME]  1
    #define    loop_sfx_exg_[AUDIO_FILENAME]  0
    #define    loop_sfx_cmp_[AUDIO_FILENAME]  1

    ALIGN 4

loop_sfx_Prologue_Line_0001:
    BYTE        VOL     127*loop_sfx_mvl_[AUDIO_FILENAME]/mxv
    BYTE    KEYSH   loop_sfx_key_[AUDIO_FILENAME]+0
    BYTE        VOICE   0
    BYTE        TIE     Cn3   v064
    BYTE    W96
loop_sfx_Prologue_Line_0001_B1:
    BYTE    W96
    BYTE    W96
    BYTE    GoTo
     POIN2    loop_sfx_Prologue_Line_0001_B1
loop_sfx_Prologue_Line_0001_B2:
    BYTE    W06
    BYTE        EOT     Cn3 
    BYTE    FINE

    ALIGN 4

[AUDIO_FILENAME]:
    BYTE    1    // NumTrks
    BYTE    0    // NumBlks
    BYTE    loop_sfx_pri_[AUDIO_FILENAME]    // Priority
    BYTE    loop_sfx_rev_[AUDIO_FILENAME]    // Reverb.

    POIN2    loop_sfx_grp_[AUDIO_FILENAME]

    POIN2    loop_sfx_Prologue_Line_0001

    
[AUDIO_FILENAME]_map:
WORD $3c00
POIN [AUDIO_FILENAME]_wav
WORD $FF00FF

[AUDIO_FILENAME]_wav:
#incbin "audio/[AUDIO_FILENAME].dmp"